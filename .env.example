# Copy to .env.local and fill in. Never commit .env.local.

# Required from milestone 1
MONGODB_URI=            # Atlas connection string, e.g. mongodb+srv://user:pass@cluster.xxxx.mongodb.net/cafe
OWNER_EMAIL=            # the café owner's email; seeded as the first owner account

# Required from milestone 3 (auth and email)
BETTER_AUTH_SECRET=     # 32+ random characters: openssl rand -base64 32
RESEND_API_KEY=
EMAIL_FROM=             # "Respawn Cyber Gaming <reservations@your-domain>"
APP_URL=                # optional: public URL; on Vercel the deployment URL is used by default

# Required from milestone 8 (scheduled jobs)
CRON_SECRET=            # 16+ random characters
